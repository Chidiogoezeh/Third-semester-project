{
  "openapi": "3.0.0",
  "info": {
    "title": "Eventful API",
    "version": "1.0.0",
    "description": "Eventful backend API"
  },
  "servers": [
    {
      "url": "http://localhost:5000"
    }
  ],
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "summary": "Register user",
        "tags": ["Auth"]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Login user",
        "tags": ["Auth"]
      }
    },
    "/api/v1/events": {
      "get": {
        "summary": "Get public events",
        "tags": ["Events"]
      },
      "post": {
        "summary": "Create event",
        "tags": ["Events"]
      }
    },
    "/api/v1/events/{slug}": {
      "get": {
        "summary": "Get event details",
        "tags": ["Events"]
      }
    },
    "/api/v1/tickets/verify": {
      "post": {
        "summary": "Verify ticket",
        "tags": ["Tickets"]
      }
    },
    "/api/v1/users/me": {
      "get": {
        "summary": "Get profile",
        "tags": ["Users"]
      },
      "patch": {
        "summary": "Update profile",
        "tags": ["Users"]
      }
    },
    "/api/v1/analytics/dashboard": {
      "get": {
        "summary": "Get dashboard analytics",
        "tags": ["Analytics"]
      }
    },
    "/api/v1/events/{id}/book": {
      "post": {
        "summary": "Book an event and initialize payment",
        "tags": ["Events"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Event ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Booking initialized successfully"
          }
        }
      }
    },
    "/api/v1/payments/creator": {
      "get": {
        "summary": "Get creator payment records",
        "tags": ["Payments"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Payment records fetched"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Creator access required"
          }
        }
      }
    },
    "/api/v1/payments/webhook": {
      "post": {
        "summary": "Paystack webhook endpoint",
        "tags": ["Payments"]
      }
    }
  }
}