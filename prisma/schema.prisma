generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CREATOR
  EVENTEE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  email    String @unique
  password String
  role     Role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  events    Event[]
  tickets   Ticket[]
  reminders Reminder[]
  payments  Payment[]

  @@map("users")
}

model Event {
  id        String @id @default(uuid()) @db.Uuid
  creatorId String @db.Uuid

  title       String
  slug        String  @unique
  description String
  bannerUrl   String?

  location String

  price Int

  capacity Int?

  eventDate DateTime

  reminderWindow Int @default(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  tickets   Ticket[]
  reminders Reminder[]
  payments  Payment[]

  @@index([creatorId])
  @@index([eventDate])
  @@index([creatorId, eventDate])
  @@map("events")
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  eventId   String @db.Uuid
  eventeeId String @db.Uuid

  // Paystack transaction reference
  reference String @unique

  // Amount in kobo
  amount Int

  status PaymentStatus @default(PENDING)

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  eventee User @relation(fields: [eventeeId], references: [id], onDelete: Cascade)

  // One successful payment => one ticket
  ticket Ticket?

  @@index([eventId])
  @@index([eventeeId])
  @@index([status])
  @@index([eventId, status])
  @@index([eventeeId, status])
  @@map("payments")
}

model Ticket {
  id String @id @default(uuid()) @db.Uuid

  eventId   String @db.Uuid
  eventeeId String @db.Uuid

  paymentId String @unique @db.Uuid

  // QR code payload / verification token
  ticketToken String @unique

  isScanned Boolean @default(false)

  scannedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  eventee User @relation(fields: [eventeeId], references: [id], onDelete: Cascade)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([eventId, eventeeId])
  @@index([eventId])
  @@index([eventeeId])
  @@index([eventId, isScanned])
  @@index([eventId, scannedAt])
  @@map("tickets")
}

model Reminder {
  id String @id @default(uuid()) @db.Uuid

  eventId String @db.Uuid
  userId  String @db.Uuid

  reminderOffset Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId, reminderOffset])
  @@index([eventId])
  @@index([userId])
  @@index([eventId, reminderOffset])
  @@map("reminders")
}
